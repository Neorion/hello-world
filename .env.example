# WellWire Lite — Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection (required)
DATABASE_URL="postgresql://wellwire:wellwire@localhost:5432/wellwire"

# Email settings (optional — defaults to console.log if not set)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM=alerts@wellwire.app
# ALERT_EMAIL_TO=admin@example.com

# Cron security (optional)
# CRON_SECRET=your-random-secret-here

# App settings
NEXT_PUBLIC_APP_NAME="WellWire Lite"
NEXT_PUBLIC_APP_VERSION="0.1.0"
